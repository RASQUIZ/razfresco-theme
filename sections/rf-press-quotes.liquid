{%- comment -%} Press quotes — add, remove and reorder as blocks {%- endcomment -%}
<div id="{{ section.settings.anchor | default: 'press' }}" class="rf-hairline" style="padding:80px var(--rf-page-margin) 56px; display:flex; flex-direction:column; gap:56px;">
  <div style="display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:16px;">
    <h2 class="rf-display" style="font-size:64px;">{{ section.settings.title }}</h2>
    {%- if section.settings.link_url != blank -%}
      <a class="rf-label" href="{{ section.settings.link_url }}" style="color: rgba(255,255,255,0.65);">{{ section.settings.link_label }} &rarr;</a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="rf-quotes">
      {%- for block in section.blocks -%}
        <div class="rf-quote" {{ block.shopify_attributes }}>
          <div class="rf-quote__text">&ldquo;{{ block.settings.quote }}&rdquo;</div>
          <div class="rf-quote__source rf-label">
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">{{ block.settings.outlet }}{% if block.settings.date != blank %} &mdash; {{ block.settings.date }}{% endif %}</a>
            {%- else -%}
              {{ block.settings.outlet }}{% if block.settings.date != blank %} &mdash; {{ block.settings.date }}{% endif %}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.also != blank -%}
    <div class="rf-label" style="color: rgba(255,255,255,0.4); display:flex; flex-wrap:wrap; gap:14px; align-items:center;">
      {{ section.settings.also }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Press quotes",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "press" },
    { "type": "text", "id": "title", "label": "Title", "default": "Press" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All press" },
    { "type": "url", "id": "link_url", "label": "Link to full press page" },
    { "type": "textarea", "id": "also", "label": "\"Also in\" line" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Leave the quotation marks out — the theme adds them." },
        { "type": "text", "id": "outlet", "label": "Outlet" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "url", "id": "url", "label": "Link to the article" }
      ]
    }
  ],
  "presets": [{ "name": "Press quotes" }]
}
{% endschema %}
