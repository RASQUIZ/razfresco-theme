{%- comment -%} Outlet logo wall on the light Store surface {%- endcomment -%}
<div class="rf-logowall">
  {%- for block in section.blocks -%}
    {%- assign logo_img = '' -%}
    {%- if block.settings.image != blank -%}
      {%- assign logo_img = block.settings.image | image_url: width: 400 -%}
    {%- else -%}
      {%- assign outlet_key = block.settings.text | downcase | strip -%}
      {%- case outlet_key -%}
        {%- when 'rolling stone' -%}{%- assign logo_img = 'press-rollingstone.png' | asset_url -%}
        {%- when 'pitchfork' -%}{%- assign logo_img = 'press-pitchfork.jpg' | asset_url -%}
        {%- when 'xxl' -%}{%- assign logo_img = 'press-xxl.png' | asset_url -%}
        {%- when 'cbc' -%}{%- assign logo_img = 'press-cbc.png' | asset_url -%}
        {%- when 'muchmusic' -%}{%- assign logo_img = 'press-muchmusic.png' | asset_url -%}
        {%- when 'la presse' -%}{%- assign logo_img = 'press-lapresse.png' | asset_url -%}
        {%- when 'vice' -%}{%- assign logo_img = 'press-vice.jpg' | asset_url -%}
        {%- when 'noisey' -%}{%- assign logo_img = 'press-noisey.png' | asset_url -%}
      {%- endcase -%}
    {%- endif -%}

    {%- if logo_img != blank -%}
      {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{%- endif -%}
      <img
        src="{{ logo_img }}"
        alt="{{ block.settings.text | default: 'Press outlet' }}"
        style="height: {{ block.settings.height }}px; object-fit: contain;{% if block.settings.invert %} filter: invert(1);{% endif %}"
        loading="lazy"
        {% unless block.settings.url != blank %}{{ block.shopify_attributes }}{% endunless %}>
      {%- if block.settings.url != blank -%}</a>{%- endif -%}
    {%- elsif block.settings.text != blank -%}
      <span {{ block.shopify_attributes }} style="font-family: var(--rf-font-body); font-size:{{ block.settings.height | divided_by: 2.7 }}px; font-weight:500; color:#000; letter-spacing:-0.01em; white-space:nowrap; flex:0 0 auto;">{{ block.settings.text }}</span>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Outlet logos",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "text", "label": "Or set the name in type", "info": "Used when no image is uploaded." },
        { "type": "range", "id": "height", "label": "Height", "min": 20, "max": 80, "step": 2, "default": 30, "unit": "px" },
        { "type": "checkbox", "id": "invert", "label": "Invert (for white-on-black marks)", "default": false },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Outlet logos" }]
}
{% endschema %}
