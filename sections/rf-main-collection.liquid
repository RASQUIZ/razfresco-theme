{%- comment -%} Collection page — same grid vocabulary as the homepage band {%- endcomment -%}
<div class="rf-sectionhead">
  <h1 class="rf-sectionhead__title">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div style="font-size:18px; line-height:1.5; max-width:44ch; color: rgba(255,255,255,0.65); text-wrap:pretty;">{{ collection.description }}</div>
  {%- endif -%}
</div>

<div class="rf-light">
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="rf-grid">
        {%- for product in collection.products -%}
          <a class="rf-card" href="{{ product.url }}">
            <div class="rf-card__media">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
              {%- endif -%}
              {%- if product.images[1] -%}
                <img src="{{ product.images[1] | image_url: width: 800 }}" alt="" loading="lazy">
              {%- endif -%}
              {%- if section.settings.locked -%}
                <div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>
              {%- elsif product.available == false -%}
                <div class="rf-card__tag rf-label">Sold out</div>
              {%- endif -%}
            </div>
            <div class="rf-card__body">
              <div class="rf-card__name">{{ product.title }}</div>
              <div class="rf-card__price">{{ product.price | money }}</div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="rf-grid">
        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-hoodie-7154-green-front.png' | asset_url }}" alt="7154 Heavyweight Hoodie — Green" loading="lazy">
            <img src="{{ 'prod-hoodie-7154-green-back.png' | asset_url }}" alt="7154 Heavyweight Hoodie — Green Back" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">7154 Heavyweight Hoodie</div>
            <div class="rf-card__price">$160 CAD</div>
          </div>
        </div>

        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-jersey-white-front.png' | asset_url }}" alt="Magneto Hockey Jersey — White" loading="lazy">
            <img src="{{ 'prod-jersey-white-back.png' | asset_url }}" alt="Magneto Hockey Jersey — White Back" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">Magneto Mesh Hockey Jersey</div>
            <div class="rf-card__price">$180 CAD</div>
          </div>
        </div>

        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-sshood-black-front.png' | asset_url }}" alt="Short Sleeve Pullover — Black" loading="lazy">
            <img src="{{ 'prod-sshood-black-back.png' | asset_url }}" alt="Short Sleeve Pullover — Black Back" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">Raw Hem Short Sleeve Hoodie</div>
            <div class="rf-card__price">$130 CAD</div>
          </div>
        </div>

        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-hoodie-7154-brown-front.png' | asset_url }}" alt="7154 Heavyweight Hoodie — Brown" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">7154 Heavyweight Hoodie</div>
            <div class="rf-card__price">$160 CAD</div>
          </div>
        </div>

        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-tee-7154-black-front.png' | asset_url }}" alt="7154 Boxy Tee — Black" loading="lazy">
            <img src="{{ 'prod-tee-7154-black-back.png' | asset_url }}" alt="7154 Boxy Tee — Black Back" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">7154 Heavyweight Boxy Tee</div>
            <div class="rf-card__price">$75 CAD</div>
          </div>
        </div>

        <div class="rf-card">
          <div class="rf-card__media">
            <img src="{{ 'prod-zip-peace-black-front.png' | asset_url }}" alt="Peace Full Zip — Black" loading="lazy">
            {%- if section.settings.locked -%}<div class="rf-card__tag rf-label">{{ section.settings.lock_badge }}</div>{%- endif -%}
          </div>
          <div class="rf-card__body">
            <div class="rf-card__name">Peace Full Zip Thermal Jacket</div>
            <div class="rf-card__price">$195 CAD</div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div style="padding:24px var(--rf-page-margin); display:flex; gap:16px;" class="rf-label">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "checkbox", "id": "locked", "label": "Show locked badges", "default": true },
    { "type": "text", "id": "lock_badge", "label": "Badge", "default": "Locked" }
  ]
}
{% endschema %}
