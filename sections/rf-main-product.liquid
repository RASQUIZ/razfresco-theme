{%- comment -%}
  Product page — front and back images stacked, info column sticky beside them.
  When the collection band is locked, Add to Cart is replaced by the waitlist form.
{%- endcomment -%}
{%- liquid
  assign locked = section.settings.locked
  assign current = product.selected_or_first_available_variant
-%}

<div class="rf-product" data-rf-product>
  <div class="rf-product__media">
    {%- for image in product.images -%}
      <img
        src="{{ image | image_url: width: 1400 }}"
        alt="{{ image.alt | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
    {%- endfor -%}
  </div>

  <div class="rf-product__info">
    <div style="display:flex; flex-direction:column; gap:10px;">
      {%- if locked -%}
        <div class="rf-label" style="color: var(--rf-red);">{{ section.settings.lock_badge }}</div>
      {%- endif -%}
      <h1 class="rf-product__title">{{ product.title }}</h1>
      <div class="rf-product__price" data-rf-price>{{ current.price | money }}</div>
    </div>

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        <div class="rf-variants">
          <div class="rf-variants__label rf-label">{{ option.name }}</div>
          <div class="rf-swatches" role="radiogroup" aria-label="{{ option.name }}">
            {%- for value in option.values -%}
              {%- liquid
                assign target = null
                for v in product.variants
                  if v.options[forloop.parentloop.index0] == value
                    assign target = v
                    break
                  endif
                endfor
              -%}
              {%- if target -%}
                <button
                  class="rf-swatch"
                  type="button"
                  role="radio"
                  data-rf-swatch="{{ target.id }}"
                  aria-checked="{% if target.id == current.id %}true{% else %}false{% endif %}"
                  {% unless target.available %}disabled{% endunless %}>{{ value }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endunless -%}

    {%- if locked -%}
      <div style="display:flex; flex-direction:column; gap:12px;">
        <div style="font-size:16px; line-height:1.5; color: rgba(255,255,255,0.65); text-wrap:pretty;">{{ section.settings.locked_note }}</div>
        {%- form 'customer', class: 'rf-signup__fields' -%}
          {%- if form.posted_successfully? -%}
            <p class="rf-form__success">{{ section.settings.locked_success }}</p>
          {%- elsif form.errors -%}
            <p class="rf-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.waitlist_tag }}, waitlist-{{ product.handle }}">
          <input class="rf-input" type="email" name="contact[email]" placeholder="Email address" required>
          <button class="rf-btn rf-btn--primary rf-btn--full" type="submit">{{ section.settings.locked_cta }}</button>
        {%- endform -%}
      </div>
    {%- else -%}
      {%- form 'product', product, id: 'rf-product-form' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-rf-variant-id>
        <button
          class="rf-btn rf-btn--primary rf-btn--full"
          type="submit"
          data-rf-submit
          data-rf-label="{{ section.settings.add_label }}"
          {% unless current.available %}disabled{% endunless %}>
          {%- if current.available -%}{{ section.settings.add_label }}{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}
    {%- endif -%}

    {%- if product.description != blank -%}
      <div class="rf-product__desc">{{ product.description }}</div>
    {%- endif -%}

    <script type="application/json" data-rf-variant-data>
      [
        {%- for v in product.variants -%}
          {"id": {{ v.id }}, "available": {{ v.available }}, "price_formatted": {{ v.price | money | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "header", "content": "Launch gate" },
    { "type": "checkbox", "id": "locked", "label": "Locked — waitlist instead of Add to Cart", "default": true, "info": "Match this to the homepage collection band." },
    { "type": "text", "id": "lock_badge", "label": "Badge", "default": "Locked until launch" },
    { "type": "textarea", "id": "locked_note", "label": "Waitlist note", "default": "Join the waitlist and you'll get the password before this opens." },
    { "type": "text", "id": "locked_cta", "label": "Waitlist button", "default": "Join the waitlist" },
    { "type": "text", "id": "waitlist_tag", "label": "Customer tag", "default": "c-01-waitlist" },
    { "type": "text", "id": "locked_success", "label": "Success message", "default": "You're on the list." }
  ]
}
{% endschema %}
