{%- comment -%} Storefront password page {%- endcomment -%}
<div style="min-height:100vh; display:flex; flex-direction:column; justify-content:center; gap:40px; padding: var(--rf-page-margin);">
  <img src="{{ 'razfresco-white.png' | asset_url }}" alt="{{ shop.name }}" style="width:100%; max-width:900px; height:auto; display:block;">

  <div style="display:flex; flex-direction:column; gap:16px; max-width:420px;">
    <div class="rf-label" style="color: var(--rf-green);">{{ section.settings.heading }}</div>
    {%- form 'storefront_password', class: 'rf-signup__fields' -%}
      {%- if form.errors -%}<p class="rf-form__error">{{ form.errors.messages.form }}</p>{%- endif -%}
      <input class="rf-input" type="password" name="password" placeholder="Password" autocomplete="current-password">
      <button class="rf-btn rf-btn--primary" type="submit">Enter</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Members only" }
  ]
}
{% endschema %}
